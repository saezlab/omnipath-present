# Example .env for a non-Dokploy deployment via docker-compose.deploy.yaml.
# Copy to ~/instances/<name>/.env and customise the per-instance values.
#
# Host ports (must be unique across instances on the same host):
SVELTE_PORT=8002
API_PORT=8012
POSTGRES_PORT=5402

# Data inputs (read-only mounts):
DATA_DIR=/home/omnipath/data/omnipath-build/combined
ONTOLOGY_DIR=/home/omnipath/data/omnipath-build/silver
GOLD_ROOT_DIR=/home/omnipath/data/omnipath-build/gold

# Per-instance docker volume names:
POSTGRES_DATA_VOLUME_NAME=omnipath-present-dev2-pgdata
ONTOLOGY_CACHE_VOLUME_NAME=omnipath-present-dev2-cache

# SvelteKit build args:
PUBLIC_ENVIRONMENT=development
PUBLIC_DOMAIN=dev2.omnipathdb.org

# Optional LLM chat backend (leave empty to disable):
OPENROUTER_API_KEY=
CHAT_MODEL_PROVIDER=openrouter
OPENROUTER_CHAT_MODEL=gpt-4o
