# PostgreSQL connection used by SvelteKit server-only modules.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/omnipath

# FastAPI/backend service URL. In Docker this is usually the service name URL.
API_SERVICE_URL=http://localhost:8000

# Set to true in containerized deployments when server code needs Docker-specific URLs.
DOCKERIZED=false

# Chat model provider: openrouter, google, or cerebras.
CHAT_MODEL_PROVIDER=openrouter

# OpenRouter configuration.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=

# Google Generative AI configuration.
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_CHAT_MODEL=

# Cerebras configuration.
CEREBRAS_API_KEY=
CEREBRAS_CHAT_MODEL=
