FROM python:3.12-slim

WORKDIR /app

# Install git (required for git-based dependencies) and uv
RUN apt-get update && apt-get install -y git && rm -rf /var/lib/apt/lists/*
RUN pip install uv

# Copy dependency files
COPY api-service/pyproject.toml .
COPY api-service/README.md .

# Copy application code
COPY api-service/api_service/ api_service/

# Install dependencies
# ARG busts cache when ontograph version changes - update this arg value to force reinstall
ARG ONTOGRAPH_VERSION=2026-02-27
RUN uv pip install --system "ontograph@git+https://github.com/saezlab/ontograph.git@main"
RUN uv pip install --system -e .

# Create data and cache directories
RUN mkdir -p /app/data /app/cache

ENV ONTOLOGY_DATA_DIR=/app/data
ENV ONTOLOGY_CACHE_DIR=/app/cache

EXPOSE 8081

CMD ["uvicorn", "api_service.main:app", "--host", "0.0.0.0", "--port", "8081"]
