# Search backend
# If DATABASE_URL is set, entity / interaction / association search will use PostgreSQL.
# Set SEARCH_BACKEND=meili to force the legacy Meilisearch path.
DATABASE_URL=
OMNIPATH_PG_SCHEMA=public
SEARCH_BACKEND=postgres

# Primary provider
CEREBRAS_API_KEY=

# Alternative providers
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# Optional chat provider override: "cerebras", "google", or "openrouter"
CHAT_MODEL_PROVIDER=openrouter

# Optional model overrides
CEREBRAS_CHAT_MODEL=gpt-oss-120b
GOOGLE_CHAT_MODEL=gemini-3-flash-preview
OPENROUTER_CHAT_MODEL=openai/gpt-oss-120b
