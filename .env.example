# Search backend
DATABASE_URL="postgresql://omnipath:omnipath@localhost:55432/omnipath"
OMNIPATH_PG_SCHEMA="public"
SEARCH_BACKEND="postgres"

# PostgreSQL tuning defaults target a 12GB SSD host.
# shared_buffers ~= 25% RAM; effective_cache_size ~= 75% RAM.
POSTGRES_SHARED_BUFFERS="3GB"
POSTGRES_WORK_MEM="32MB"
POSTGRES_MAINTENANCE_WORK_MEM="1GB"
POSTGRES_EFFECTIVE_CACHE_SIZE="9GB"
POSTGRES_MAX_WAL_SIZE="12GB"
POSTGRES_MIN_WAL_SIZE="2GB"
POSTGRES_CHECKPOINT_TIMEOUT="15min"
POSTGRES_CHECKPOINT_COMPLETION_TARGET="0.9"
POSTGRES_RANDOM_PAGE_COST="1.1"

# Node environment
NODE_ENV="development"
DOCKERIZED="true"
