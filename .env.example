# Search backend
DATABASE_URL="postgresql://localhost:5432/omnipath"
OMNIPATH_PG_SCHEMA="public"
SEARCH_BACKEND="postgres"

# Legacy Meilisearch configuration (only used when SEARCH_BACKEND=meili or DATABASE_URL is unset)
MEILISEARCH_API_KEY="your-secure-key-here"
MEILI_ENV="development"

# Cerebras AI (for chat features)
CEREBRAS_API_KEY="your-api-key-here"

# Node environment
NODE_ENV="production"
DOCKERIZED="true"

# Logging
RUST_LOG="info"